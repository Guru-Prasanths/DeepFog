# DEEPFOG - Backend Environment Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database (optional — server runs in demo mode without it)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/deepfog

# Frontend URL (CORS allowed origins)
FRONTEND_URL=*

# ESP32 Authentication Key
ESP32_API_KEY=your_secret_key_here

# Demo Mode (set to true for simulated data without PostgreSQL)
DEMO_MODE=true
